# =============================================================
# Kreotype Production Environment — Docker / Coolify
# =============================================================
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to git.
# =============================================================

# Database (Docker-internal hostname "mongo")
MONGODB_URI=mongodb://kreotype:changeme_in_production@mongo:27017/kreotype?authSource=admin

# Redis (Docker-internal hostname "redis")
REDIS_URL=redis://redis:6379

# Auth (NextAuth v5 / Auth.js)
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=https://yourdomain.com

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=noreply@yourdomain.com

# Docker Compose MongoDB credentials (must match MONGODB_URI above)
MONGO_USER=kreotype
MONGO_PASS=changeme_in_production
